# Sunucu
PORT=3000
NODE_ENV=production

# Shopify App Bilgileri
# Shopify Partners > Apps > API credentials bölümünden alınır
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SHOP_DOMAIN=yourstore.myshopify.com

# Shopify Admin API Token (mağazaya yönelik)
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx

# Tami API Bilgileri (dev.tami.com.tr üzerinden alınır)
TAMI_API_BASE_URL=https://dev.tami.com.tr
TAMI_API_KEY=your_tami_api_key
TAMI_API_SECRET=your_tami_api_secret
TAMI_MERCHANT_ID=your_merchant_id

# Bu uygulamanın public URL'si (Shopify callback için)
APP_BASE_URL=https://yourdomain.com
