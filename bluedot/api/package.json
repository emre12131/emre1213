{
  "name": "bluedot-api",
  "version": "1.0.0",
  "description": "Bluedot Node.js API — auth, storage, webhooks",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev":     "nodemon --watch src src/index.js",
    "start":   "node src/index.js",
    "db:push": "prisma db push",
    "db:seed": "node src/utils/seed.js"
  },
  "dependencies": {
    "@prisma/client":  "^5.19.0",
    "bcryptjs":        "^2.4.3",
    "cors":            "^2.8.5",
    "dotenv":          "^16.4.5",
    "express":         "^4.21.0",
    "express-validator":"^7.2.0",
    "jsonwebtoken":    "^9.0.2",
    "multer":          "^1.4.5-lts.1",
    "uuid":            "^10.0.0"
  },
  "devDependencies": {
    "nodemon":  "^3.1.7",
    "prisma":   "^5.19.0"
  }
}
